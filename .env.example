# Application Settings
APP_NAME="Flight Smart Booking POC (LastSeat)"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Security - Partner Ingestion API Key
PARTNER_API_KEY="sk-partner-charter-secret-key-2026"

# PostgreSQL Configuration (Asyncpg - mapped to host port 15432)
POSTGRES_USER="lastseat"
POSTGRES_PASSWORD="lastseat_password"
POSTGRES_DB="lastseat_db"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=15432
DATABASE_URL="postgresql+asyncpg://lastseat:lastseat_password@127.0.0.1:15432/lastseat_db"

# Redis Configuration (Streams, Distributed Locks & Idempotency - mapped to host port 16379)
REDIS_URL="redis://127.0.0.1:16379/0"
REDIS_DEALS_STREAM="stream:flight_deals"
REDIS_CONSUMER_GROUP="cg:booking_engine"
REDIS_CONSUMER_NAME="worker-1"
REDIS_LOCK_TTL_SECONDS=15
REDIS_IDEMPOTENCY_TTL_SECONDS=86400

# GDS / Poller Simulation Configuration
POLLER_ENABLED=true
POLLER_INTERVAL_SECONDS=12
GDS_SIMULATED_FAILURE_RATE=0.15
GDS_SIMULATED_LATENCY_MS=250
